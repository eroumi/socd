# Discord Sentinel Network Configuration

# --- BOT TOKENS ---
# Her bot için ayrı bir Discord Bot Token'ı girilmelidir.
GUARD_I_TOKEN=YOUR_GUARD_I_TOKEN
GUARD_II_TOKEN=YOUR_GUARD_II_TOKEN
GUARD_III_TOKEN=YOUR_GUARD_III_TOKEN
SYSTEM_BOT_TOKEN=YOUR_SYSTEM_BOT_TOKEN
TICKET_BOT_TOKEN=YOUR_TICKET_BOT_TOKEN
LOG_BOT_TOKEN=YOUR_LOG_BOT_TOKEN

# --- GENERAL SETTINGS ---
# Veritabanı dosyasının adı
DATABASE_FILE=sentinel.db

# Sunucu ID'si
GUILD_ID=YOUR_SERVER_ID

# Whitelist: Bu kullanıcıların ID'lerine botlar asla müdahale etmez. (Virgülle ayırın)
WHITELIST_USERS=USER_ID_1,USER_ID_2

# --- LOG CHANNEL IDs ---
# Log Bot'un mesaj göndereceği kanalların ID'leri
MOD_LOG_CHANNEL=CHANNEL_ID_FOR_MODERATION_LOGS
GUARD_LOG_CHANNEL=CHANNEL_ID_FOR_GUARD_LOGS
TICKET_LOG_CHANNEL=CHANNEL_ID_FOR_TICKET_LOGS
ERROR_LOG_CHANNEL=CHANNEL_ID_FOR_ERROR_LOGS

# --- GUARD I (Server & Structure Protector) SETTINGS ---
# Kullanıcının sunucudan atılması için gereken ihlal sayısı.
VIOLATION_LIMIT=3
# İhlallerin sıfırlanacağı zaman aralığı (saat cinsinden).
VIOLATION_TIME_WINDOW_HOURS=24

# --- GUARD II (Message & Chat Protector) SETTINGS ---
# Yasaklı kelimeler (küfür, reklam vb.). (Virgülle ayırın)
FORBIDDEN_WORDS=word1,word2,word3

# Spam tespiti için mesaj sayısı ve saniye.
SPAM_MESSAGE_COUNT=5
SPAM_TIME_SECONDS=5

# --- TICKET BOT SETTINGS ---
# Ticket kanallarının oluşturulacağı kategori ID'si.
TICKET_CATEGORY_ID=CATEGORY_ID_FOR_TICKETS
# Ticketları yönetebilecek yetkili rol ID'si.
TICKET_SUPPORT_ROLE_ID=ROLE_ID_FOR_SUPPORT_STAFF

# --- SYSTEM BOT SETTINGS ---
# Moderasyon komutlarını kullanabilecek rollerin ID'leri. (Virgülle ayırın)
ADMIN_ROLE_IDS=ROLE_ID_1,ROLE_ID_2
